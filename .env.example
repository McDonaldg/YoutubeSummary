# YouTube Data API v3 (https://console.cloud.google.com/apis/credentials)
YOUTUBE_API_KEY=

# Anthropic Claude API (https://console.anthropic.com/settings/keys)
# 未設定の場合、要約は簡易抽出フォールバックで動作します（コスト0）
ANTHROPIC_API_KEY=

# 検索キーワード（カンマ区切り、複数可）
YT_QUERIES=生成AI 活用事例,Python 自動化

# 1クエリあたりの最大取得件数（API無料枠保護のため 5〜10 を推奨、上限10）
YT_MAX_RESULTS=5

# 抽出対象とする動画の再生時間（分）
YT_MIN_DURATION_MIN=10
YT_MAX_DURATION_MIN=30

# 字幕の優先言語
YT_TRANSCRIPT_LANG=ja

# Claude要約モデルと出力上限トークン
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1500

# スライド出力形式: pptx または html
SLIDE_FORMAT=pptx
